# 로컬 키 양식. 실제 값은 .env(무시 경로)·Vercel 환경 변수에만 둔다.
# 반박 검토(app/validation/rebuttal.py)가 쓴다. 키가 없으면 판단 실행이 실패로 끝난다(추측으로 통과시키지 않음)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# D 지식베이스(근거 검색·면책 조항 판정, app/main.py). 1이면 서버 시작 때 켠다. 비우면 꺼짐, Vercel에는 두지 않는다
# 로컬 data/private/corpus-db-import/db_import와 OPENAI_API_KEY가 필요하고 시작에 약 12초·230MB가 든다
# 파일·키가 없거나 못 쓰면 경고 로그만 남기고 꺼진 채로 시작한다(면책은 담당자 입력으로 판정)
LOAD_KNOWLEDGE_BASE=
# AI Hub 데이터 다운로드 (aihubshell) — evals/vision/README.md
AIHUB_API_KEY=
# 비전 평가 VLM 비교 실행 (evals/vision/run_cards.py) — Claude로 돌릴 때만
ANTHROPIC_API_KEY=

# 서버 인증 (app/config.py). 둘 중 하나 이상이 없으면 보호 경로는 503으로 닫힌다
# SUPABASE_URL을 두면 {URL}/auth/v1/.well-known/jwks.json 공개키로 비대칭 서명 토큰을 검증한다
SUPABASE_URL=
# 레거시 HS256 비밀키를 쓰는 프로젝트만
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# 서버 전용 Storage 키(app/storage.py) — 견적서 PDF 내려받기. Supabase API Keys의 Secret key. 비우면 견적서 경로는 503
SUPABASE_SECRET_KEY=

# 서버 전용 영상 분석 Modal 호출(app/modal_dispatch.py). 넷이 다 있어야 분석 접수가 Modal을 부르고, 없으면 analysis_not_configured
# MODAL_ANALYZE_URL: Modal 웹 엔드포인트(spawn 뒤 call_id만 돌려줌). MODAL_PROXY_KEY·SECRET: Modal 프록시 인증 토큰(Vercel Sensitive)
# PUBLIC_BACKEND_URL: Modal이 콜백할 BE 주소. 비우면 Vercel이 주는 VERCEL_PROJECT_PRODUCTION_URL을 쓴다
MODAL_ANALYZE_URL=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
PUBLIC_BACKEND_URL=

# 서버 전용 DB(app/db.py) — 판단 실행 저장·LangGraph 체크포인트. Supabase Connect → Session pooler URI(5432)
# 직접 연결 주소는 IPv6 전용, Transaction pooler(6543)는 search_path가 유지되지 않아 쓰지 않는다
# 비밀번호는 [YOUR-PASSWORD] 대괄호까지 바꿔 그대로 넣는다(특수문자는 서버가 인코딩). 비우면 판단 API는 503
DATABASE_URL=

# FE 출처(쉼표 구분). 비우면 CORS 헤더를 내지 않는다
CORS_ALLOW_ORIGINS=http://localhost:3000

# 로컬 전용 인증 우회. APP_ENV=local일 때만 동작하고 Vercel 위에서는 무시된다
APP_ENV=local
DEV_ACTOR_ID=

# 마이그레이션 동작 검사(tests/migrations). 버려도 되는 로컬 Postgres 관리자 주소만 넣는다. Supabase 주소 금지
# 예: postgresql://postgres:postgres@127.0.0.1:54329/postgres (supabase/migrations/README.md 「로컬 검사」)
MIGRATION_TEST_DATABASE_URL=
